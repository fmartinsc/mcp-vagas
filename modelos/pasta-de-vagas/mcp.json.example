{
  "mcpServers": {
    "vagas": {
      "command": "__PYTHON__",
      "args": [
        "-m",
        "vagas.server"
      ],
      "env": {
        "VAGAS_DB": "__PASTA__/dados/vagas.db",
        "VAGAS_SKILL_DIR": "__REPO__/skill/candidaturas",
        "VAGAS_SALARY_POLICY": "__REPO__/skill/candidaturas/politica-salarial.md",
        "VAGAS_TRIAGE_CRITERIA": "__REPO__/skill/candidaturas/criterios-triagem.md",
        "VAGAS_RESUME_OUT": "__PASTA__/curriculos",
        "VAGAS_EXPORT_DIR": "__PASTA__/exportacoes",
        "VAGAS_AUTO_SUBMIT": "nao",
        "BROWSER": "__PASTA__/abrir-no-chrome.sh"
      }
    }
  }
}
